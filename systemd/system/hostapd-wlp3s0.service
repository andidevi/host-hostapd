[Unit]
Description=hostapd AP on wlp3s0 (testessid, WPA3-SAE)
Documentation=man:hostapd(8)
Wants=sys-subsystem-net-devices-wlp3s0.device systemd-networkd.service
After=sys-subsystem-net-devices-wlp3s0.device network-pre.target systemd-networkd.service
Before=network.target
BindsTo=sys-subsystem-net-devices-wlp3s0.device
Conflicts=hostapd.service wpa_supplicant.service wpa_supplicant@wlp3s0.service NetworkManager.service iwd.service

[Service]
Type=simple
ExecStartPre=/sbin/iw phy phy0 interface add wlp3s0 type __ap 2>/dev/null || true
ExecStart=/usr/sbin/hostapd /srv/hostapd/wlp3s0.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
