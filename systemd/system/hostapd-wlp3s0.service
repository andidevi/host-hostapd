[Unit]
Description=hostapd AP on wlp3s0 (WPA3-SAE, SSID/Passwort aus /srv/hostapd/values)
Documentation=man:hostapd(8)
Wants=sys-subsystem-net-devices-wlp3s0.device
After=sys-subsystem-net-devices-wlp3s0.device network.target
BindsTo=sys-subsystem-net-devices-wlp3s0.device
Conflicts=hostapd.service wpa_supplicant.service wpa_supplicant@wlp3s0.service NetworkManager.service iwd.service
# dmesg-Watchdog mitstarten (siehe systemd/system/hostapd-dmesg-watchdog-wlp3s0.service)
Wants=hostapd-dmesg-watchdog-wlp3s0.service
# Hardcap gegen Restart-Schleifen (falls der Firmware-Fehler direkt beim
# Teardown erneut auftritt): max. 8 Starts in 5 Minuten
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /run/hostapd && cp /srv/hostapd/wlp3s0.conf /run/hostapd/wlp3s0.conf && printf "ssid=%%s\n" "$(cat /srv/hostapd/values/ssid)" >> /run/hostapd/wlp3s0.conf && printf "sae_password=%%s\n" "$(cat /srv/hostapd/values/password)" >> /run/hostapd/wlp3s0.conf && chmod 0600 /run/hostapd/wlp3s0.conf'
ExecStart=/usr/sbin/hostapd /run/hostapd/wlp3s0.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
