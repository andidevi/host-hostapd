# Static AP address + built-in DHCP server via systemd-networkd.
# Installed by install.sh to: /etc/systemd/network/20-wlp3s0-ap.network
[Match]
Name=wlp3s0

[Network]
Address=192.168.70.1/24
DHCPServer=yes
IPv6SendRA=no
LinkLocalAddressing=no

[DHCPServer]
PoolStart=192.168.70.10
PoolSize=100
DefaultLeaseTimeSec=3600
MaxLeaseTimeSec=7200
EmitDNS=yes
DNS=192.168.70.1
